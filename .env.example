# Local development with a persistent SQLite file.
DATA_STORE=sqlite
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
DATABASE_PATH=./var/kavu.db
APP_ORIGIN=http://localhost:5173
APP_ADDITIONAL_ORIGINS=
# The Node server reads process environment variables. To load this file explicitly:
# node --env-file=.env --import tsx server/index.ts

# MET Norway uses a project-identifying User-Agent and requires no paid API key.
WEATHER_USER_AGENT="Kavu/1.0 https://github.com/shi1720/Hack-The-Weather"

# Cloud Run environment configuration for the full Firebase application.
# Replace the local values above with these when configuring that service.
# Hosting/Cloud Run project: gen-lang-client-0444960702
# Cloud Run service: kavu-api in europe-west1
# Dedicated Firestore project/database: kavu-drying / (default), europe-west1
# Runtime identity: kavu-runtime@gen-lang-client-0444960702.iam.gserviceaccount.com
# That identity needs roles/datastore.user only in the dedicated Firestore project.
# DATA_STORE=firestore
# GOOGLE_CLOUD_PROJECT=kavu-drying
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_COLLECTION_PREFIX=kavu
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=8080
# APP_ORIGIN=https://kavu-drying.web.app
# APP_ADDITIONAL_ORIGINS=https://kavu-drying.firebaseapp.com
# SESSION_COOKIE_NAME=__session
# TRUST_PROXY_HOPS=1
# Production uses runtime Application Default Credentials. Do not add a key file here.

# Hosted frontend build: VITE_DEMO_ONLY=false and VITE_BASE_PATH=/
# Separate optional GitHub Pages preview only:
# VITE_DEMO_ONLY=true
# VITE_BASE_PATH=/Hack-The-Weather/
